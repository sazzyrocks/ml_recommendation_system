# Secrets — copy to .env and fill in real values. Never commit .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cinematch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cinematch:changeme@localhost:5432/cinematch_db

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=REPLACE_WITH_TMDB_API_KEY
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
