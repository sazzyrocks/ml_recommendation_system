*.pyc
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.cover

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

